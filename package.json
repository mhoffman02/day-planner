{
  "name": "day-planner",
  "version": "1.0.0",
  "description": "Day Planner (GAS MVP)",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint src gas-app/*.gs gas-app/*.html tools server.js && node tools/check-gas-script-html-safe-chars.js && node tools/check-catch-logging.js && node tools/build-gas-engines.js --check && node tools/check-html.js && node tools/check-rpc-guards.js && node tools/check-mirror.js && node tools/check-css.js",
    "check:catches": "node tools/check-catch-logging.js",
    "build:engines": "node tools/build-gas-engines.js",
    "check:engines": "node tools/build-gas-engines.js --check",
    "check:gas-safe-chars": "node tools/check-gas-script-html-safe-chars.js",
    "check:handoff": "node tools/check-handoff.js",
    "sync:handoff-skill": "node tools/sync-handoff-skill.js",
    "start": "node server.js",
    "probe": "node tools/probe-live.js",
    "rpc": "node tools/gas-rpc.js",
    "smoke": "node tools/smoke-test.js",
    "audit:a11y": "node tools/audit-wcag-responsive.js",
    "sync:agents": "node tools/sync-agent-config.js",
    "sync:agents:check": "node tools/sync-agent-config.js --check",
    "stamp-build": "node tools/stamp-build-number.js",
    "push:work": "node tools/promote-to-work.js",
    "deploy:home": "node tools/deploy-home.js",
    "login:work": "npx clasp --auth ~/.clasprc.work.json login",
    "login:home": "npx clasp --auth ~/.clasprc.home.json login",
    "test:coverage": "node tools/check-coverage.js",
    "check:commit-msg": "node tools/check-commit-msg.js",
    "check:html": "node tools/check-html.js",
    "test:mutation": "stryker run"
  },
  "keywords": [
    "day-planner",
    "google-apps-script",
    "gsuite"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^8.7.1",
    "acorn": "^8.18.0",
    "axe-core": "4.10.2",
    "eslint": "^10.9.1",
    "eslint-plugin-promise": "^7.3.0",
    "fast-check": "^3.23.2",
    "html-validate": "^9.7.1"
  }
}
