{
  "name": "day-planner",
  "version": "1.0.0",
  "description": "Day Planner (GAS MVP)",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node server.js",
    "lint": "eslint src gas-app/*.gs tools server.js sw.js",
    "sync:agents": "node tools/sync-agent-config.js",
    "sync:agents:check": "node tools/sync-agent-config.js --check",
    "build:gas": "node tools/build-gas-engines.js",
    "build:gas:check": "node tools/build-gas-engines.js --check",
    "build:shell": "node tools/build-shell-bundle.js",
    "build:shell:check": "node tools/build-shell-bundle.js --check",
    "check:gas-html-safe-chars": "node tools/check-gas-script-html-safe-chars.js"
