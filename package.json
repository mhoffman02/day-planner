{
  "name": "day-planner",
  "version": "1.0.0",
  "description": "Day Planner (static client-only PWA)",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "node --test tests/*.test.js",
    "start": "node server.js",
    "lint": "eslint src gas-app/*.gs tools server.js sw.js && node tools/check-esm-imports.js && node tools/check-accessibility.js",
    "lint:esm": "node tools/check-esm-imports.js",
    "lint:a11y": "node tools/check-accessibility.js",
    "bridge": "node tools/agent-bridge.js",
    "sync:agents": "node tools/sync-agent-config.js",
    "sync:agents:check": "node tools/sync-agent-config.js --check",
    "build:gas": "node tools/build-gas-engines.js",
    "build:gas:check": "node tools/build-gas-engines.js --check",
    "check:gas-html-safe-chars": "node tools/check-gas-script-html-safe-chars.js",
    "build:sw": "node tools/update-sw-cache-version.js",
    "build:sw:check": "node tools/update-sw-cache-version.js --check"
  },
  "keywords": [
    "day-planner",
    "google-workspace",
    "google-apps-script"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1"
  }
}
