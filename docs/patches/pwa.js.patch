+// Full-page navigation straight to the live GAS deployment. This is the normal
+// workflow whenever we're online with an already-trusted source: mounting a
+// locally-fetched/cached bundle here would run the app outside the real Apps
+// Script HtmlService context, where `google.script.run` doesn't exist, so it
+// silently falls back to mock data (see docs/shell-gas-pattern.md §9, "If Live
+// 2-Way GAS Sync Is Required" — a standalone GAS deployment, not a fetched
+// bundle, is the correct approach for apps like Day Planner). The `#shell-loading`
+// spinner is already visible in the DOM by default, so this just updates its
+// caption and lets the browser's normal navigation take over.
+function redirectToApp(gasUrl, appDisplayName) {
+  const loadingText = document.getElementById('shell-loading-text');
+  if (loadingText) loadingText.textContent = `Opening ${appDisplayName}...`;
+  window.location.href = gasUrl;
+}
