#!/usr/bin/env bash
# Project-specific pre-commit checks, run by omarchy-tooling's shared hooks.d/pre-commit.d/90-project-local.
# Generic checks (.env guard, JS syntax, npm test) live in the shared hooks, not here.
# Auto-fix chores (build-number stamp, agent-config mirror sync) + safe-chars + ESLint + gitleaks.
#
# Tracked in repo. Activated via: tool-init-hooks <this-dir> --apply (core.hooksPath ->
# omarchy-tooling/hooks.d).
set -e
ERRORS=0

# ── Auto-fix: Build Number Stamp ────────────────────────────────────────────
# Keeps BUILD_NUMBER_ (DPApp.buildNumber()) (shown in the nav hover + About page) equal to the commit
# count on every commit, not just "real deploys" — see tools/stamp-build-number.js. If it
# changed gas-app/Code.gs, re-stage it so the stamp lands in this same commit.
node tools/stamp-build-number.js
git add gas-app/Code.gs

# ── Auto-fix: Agent Config Mirror Sync ──────────────────────────────────────
# .claude/ and .kilo/ are generated mirrors of .agents/ (rules/commands/skills). Regenerate
# and re-stage them instead of just failing the commit on drift.
node tools/sync-agent-config.js
git add .claude .kilo

# ── Safe Characters Check for gas-app/Script.html ───────────────────────────
# HtmlService.createHtmlOutputFromFile().getContent() silently truncates Script.html at a
# literal `//` inside a string/template literal, or an apostrophe/backtick inside a comment.
if ! node tools/check-gas-script-html-safe-chars.js; then
  echo "❌ [BLOCKER] gas-app/Script.html contains an unsafe pattern that triggers HtmlService truncation!"
  ERRORS=$((ERRORS + 1))
fi

# ── ESLint ──────────────────────────────────────────────────────────────────
if ! npm run lint; then
  echo "❌ [BLOCKER] npm run lint failed"
  ERRORS=$((ERRORS + 1))
fi

# ── Secret scan (gitleaks; allowlist in .gitleaks.toml) ─────────────────────
# CI scans history; this catches a secret before it is ever committed. A missing binary blocks
# the commit: a skipped scan is a silent failure.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "❌ [BLOCKER] gitleaks is not installed. Get the linux_x64 release from https://github.com/gitleaks/gitleaks/releases into ~/.local/bin."
  ERRORS=$((ERRORS + 1))
elif ! gitleaks git --staged --redact --no-banner --config .gitleaks.toml; then
  echo "❌ [BLOCKER] gitleaks found a secret in the staged changes"
  ERRORS=$((ERRORS + 1))
fi

if [ "$ERRORS" -gt 0 ]; then
  echo ""
  echo "❌ Pre-commit checks failed ($ERRORS error(s)). Fix issues before committing."
  exit 1
fi
exit 0
