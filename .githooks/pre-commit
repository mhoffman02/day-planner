#!/usr/bin/env bash
# Pre-commit hook: auto-fix chores (build-number stamp, agent-config mirror sync) + JSDoc @file
# header check + ESLint + Unit tests + safe-chars check.
#
# Tracked in repo. Activated via: git config core.hooksPath .githooks
set -e
ERRORS=0

echo "🔍 Pre-commit checks..."

# ── Auto-fix: Build Number Stamp ────────────────────────────────────────────
# Keeps DAY_PLANNER_BUILD_NUMBER (shown in the nav hover + About page) equal to the commit
# count on every commit, not just "real deploys" — see tools/stamp-build-number.js. If it
# changed gas-app/Code.gs, re-stage it so the stamp lands in this same commit.
node tools/stamp-build-number.js
git add gas-app/Code.gs

# ── Auto-fix: Agent Config Mirror Sync ──────────────────────────────────────
# .claude/ and .kilo/ are generated mirrors of .agents/ (rules/commands/skills). Regenerate
# and re-stage them instead of just failing the commit on drift.
node tools/sync-agent-config.js
git add .claude .kilo

# ── Safe Characters Check for gas-app/Script.html ───────────────────────────
# HtmlService.createHtmlOutputFromFile().getContent() silently truncates Script.html at a
# literal `//` inside a string/template literal, or an apostrophe/backtick inside a comment.
if ! node tools/check-gas-script-html-safe-chars.js; then
  echo "❌ [BLOCKER] gas-app/Script.html contains an unsafe pattern that triggers HtmlService truncation!"
  ERRORS=$((ERRORS + 1))
fi

# ── ESLint & Unit Tests ──────────────────────────────────────────────────────
echo "🔍 Running linter and safe-char checks..."
if ! npm run lint; then
  echo "❌ [BLOCKER] npm run lint failed"
  ERRORS=$((ERRORS + 1))
fi

echo "🧪 Running unit tests..."
if ! npm test; then
  echo "❌ [BLOCKER] npm test failed"
  ERRORS=$((ERRORS + 1))
fi

if [ "$ERRORS" -gt 0 ]; then
  echo ""
  echo "❌ Pre-commit checks failed ($ERRORS error(s)). Fix issues before committing."
  exit 1
else
  echo "✅ All pre-commit checks passed cleanly."
  exit 0
fi
