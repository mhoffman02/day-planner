  PENDING: 'PENDING',
  DONE: 'DONE',
  ERROR: 'ERROR',
  SKIPPED: 'SKIPPED',
  DEFERRED: 'DEFERRED',
  DRY_RUN: 'DRY_RUN'
});

const LEDGER_COLUMNS = Object.freeze([
  'OperationKey', 'SourceType', 'SourceId', 'SourceVersion', 'Action', 'TargetType', 'TargetId',
  'Status', 'CreatedAt', 'UpdatedAt', 'ErrorCode', 'ErrorMessage', 'MetadataJson'
