{
  "permissions": {
    "allow": [
      "Bash(npm run rpc:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/edit-gate.js\"",
            "timeout": 90
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/agent-heartbeat.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
